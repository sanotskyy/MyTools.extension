@echo off
chcp 65001 >nul 2>&1
setlocal EnableDelayedExpansion

set "INSTALL_DIR=%APPDATA%\pyRevit\Extensions"
set "EXT_NAME=MyTools.extension"
set "DEST=%INSTALL_DIR%\%EXT_NAME%"

set "INSTALLED=0"
if exist "%DEST%\extension.json" set "INSTALLED=1"

cls
echo ╔═══════════════════════════════════════════════════════╗
echo ║        MyTools для pyRevit — Інсталятор v2.3.1        ║
echo ║   QR-код • Зображення • Листи • Піпетка • Диспетчер   ║
echo ║   сімейств (новий!)                                   ║
echo ╚═══════════════════════════════════════════════════════╝
echo.
echo Папка: %DEST%
echo.
if "%INSTALLED%"=="1" (
    echo [!] MyTools вже встановлено.
    echo.
    echo  [1] Перевстановити ^(Диспетчер: швидкий пошук у проєкті^)
    echo  [2] Видалити
    echo  [3] Скасувати
    echo.
    choice /c 123 /n /m "Оберіть дію [1/2/3]: "
    if errorlevel 3 goto :cancelled
    if errorlevel 2 goto :uninstall
    if errorlevel 1 goto :reinstall
) else (
    echo  MyTools не встановлено.
    echo.
    echo  [1] Встановити
    echo  [2] Скасувати
    echo.
    choice /c 12 /n /m "Оберіть дію [1/2]: "
    if errorlevel 2 goto :cancelled
    if errorlevel 1 goto :install
)

:uninstall
echo.
echo [*] Видалення...
rmdir /s /q "%DEST%"
if not exist "%DEST%" ( echo. & echo Видалено! & echo Виконайте pyRevit -^> Reload. ) else ( echo [X] Помилка. )
pause & exit /b 0

:reinstall
echo.
echo [*] Видалення...
rmdir /s /q "%DEST%"
goto :install

:install
if not exist "%INSTALL_DIR%" mkdir "%INSTALL_DIR%"
echo.
echo [1/3] Підготовка архіву...
set "TMP_B64=%TEMP%\mytools_b64.tmp"
set "TMP_ZIP=%TEMP%\mytools.zip"
if exist "%TMP_B64%" del /f /q "%TMP_B64%"
if exist "%TMP_ZIP%" del /f /q "%TMP_ZIP%"
